# -------------------------------
# Tower of Hanoi
# -------------------------------
print("\n\n----- TOWER OF HANOI OUTPUT -----")

def tower(n, source, helper, destination):
    if n == 1:
        print("Move disk from", source, "to", destination)
        return

    tower(n - 1, source, destination, helper)
    print("Move disk from", source, "to", destination)
    tower(n - 1, helper, source, destination)


# calling function
tower(3, 'A', 'B', 'C')
