print("----- 3 SUM OUTPUT -----")

nums = [5, 6, -3, 8, 1, 9, 2]
nums.sort()

for i in range(len(nums) - 2):
    left = i + 1
    right = len(nums) - 1

    while left < right:
        total = nums[i] + nums[left] + nums[right]

        if total == 0:
            print(nums[i], nums[left], nums[right])
            left += 1
            right -= 1

        elif total < 0:
            left += 1
        else:
            right -= 1


