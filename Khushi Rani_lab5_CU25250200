# Postfix Expression Evaluation

def evaluate_postfix(expression):
    stack = []

    for ch in expression:
        # digit
        if ch.isdigit():
            stack.append(int(ch))
        else:
            val2 = stack.pop()
            val1 = stack.pop()

            if ch == '+':
                stack.append(val1 + val2)
            elif ch == '-':
                stack.append(val1 - val2)
            elif ch == '*':
                stack.append(val1 * val2)
            elif ch == '/':
                stack.append(val1 // val2)

    return stack[0]

# Example
postfix_exp = "23*54*+9-"
answer = evaluate_postfix(postfix_exp)
print("Final Answer:", answer)
