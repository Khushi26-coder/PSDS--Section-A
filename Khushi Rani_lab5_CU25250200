# Infix to Postfix Conversion

def precedence(op):
    if op == '+' or op == '-':
        return 1
    elif op == '*' or op == '/':
        return 2
    else:
        return 0

def infix_to_postfix(expression):
    stack = []
    postfix = ""

    for ch in expression:
        # operand
        if ch.isalnum():
            postfix += ch
        # (
        elif ch == '(':
            stack.append(ch)
        # )
        elif ch == ')':
            while stack and stack[-1] != '(':
                postfix += stack.pop()
            stack.pop()
        # operator
        else:
            while stack and precedence(stack[-1]) >= precedence(ch):
                postfix += stack.pop()
            stack.append(ch)

    while stack:
        postfix += stack.pop()

    return postfix

# Example
exp = "A+(B*C)"
result = infix_to_postfix(exp)
print("Postfix Expression:", result)

